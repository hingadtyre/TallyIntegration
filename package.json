{
  "name": "tally-marketplace-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint src tests scripts/*.mjs vite.config.ts --max-warnings 0",
    "verify": "npm run format:check && npm run lint && npm test && npm run build",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.mjs",
    "package:pilot": "npm run verify && node scripts/package-pilot.mjs",
    "test:pilot": "node scripts/verify-pilot.mjs",
    "restore:pilot": "tsc -p tsconfig.json && node scripts/restore-pilot.mjs",
    "start": "node dist/src/server/main.js",
    "demo": "node dist/src/server/main.js --demo"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "marked": "18.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
